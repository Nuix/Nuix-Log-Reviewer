<Window x:Class="NuixLogReviewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NuixLogReviewer.GUI"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Nuix Log Reviewer" Height="768" Width="1024"
        Background="{StaticResource Brush.WindowBackground}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisPattern"/>
        <!--
          Header style for the Patterns grid that shows a sort-direction arrow on the active column.
          The arrow is driven by each header's Tag: "asc" shows an up arrow, "desc" a down arrow, and
          anything else (empty/null) hides it. The code-behind (patternList_ColumnHeaderClick) sets
          the active header's Tag and clears the others, so exactly one arrow is visible at a time.
          Content stays the plain header string, so the click handler's string checks still hold.
        -->
        <Style x:Key="SortableHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource Size.FontBase}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,1" Padding="6,3">
                                <DockPanel LastChildFill="True">
                                    <!-- Sort arrow, docked right of the header text. -->
                                    <Path x:Name="SortArrow" DockPanel.Dock="Right"
                                          Width="8" Height="8" Margin="6,0,0,0"
                                          VerticalAlignment="Center" Stretch="Uniform"
                                          Fill="{StaticResource Brush.Brand}" Visibility="Collapsed"
                                          Data="M 0,0 L 8,0 L 4,5 Z"/>
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Descending: down-pointing triangle (the default Data above). -->
                            <Trigger Property="Tag" Value="desc">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0,0 L 8,0 L 4,5 Z"/>
                            </Trigger>
                            <!-- Ascending: up-pointing triangle. -->
                            <Trigger Property="Tag" Value="asc">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0,5 L 8,5 L 4,0 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <!-- Compact Nuix logo at the right of the menu bar; small height keeps real estate free. -->
                <Image DockPanel.Dock="Right" Source="Assets/nuix-logo.png" Height="18" Margin="6,2,8,2"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       ToolTip="Nuix Log Reviewer"/>
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="_File">
                        <MenuItem Header="_Load Nuix Logs" Name="menuLoadNuixLogs" Click="menuLoadNuixLogs_Click" IsCheckable="True">
                            <MenuItem.Icon>
                                <Image Source="folder_page.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Load Logs from _Directory" Name="menuLoadDirectory" Click="menuLoadDirectory_Click">
                            <MenuItem.Icon>
                                <Image Source="folder.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="E_xport Current Entries" Name="menuExportCurrentEntries" Click="menuExportCurrentEntries_Click">
                            <MenuItem.Icon>
                                <Image Source="page_save.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_Searches">
                        <MenuItem Header="Save Current Search As..." Name="menuSaveCurrentSearch" Click="menuSaveCurrentSearch_Click">
                            <MenuItem.Icon>
                                <Image Source="report_disk.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Append To Current Search..." Name="menuAppendSearch">
                            <MenuItem.Icon>
                                <Image Source="zoom_in.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="_Replace Current Search With..." Name="menuReplaceSearch">
                            <MenuItem.Icon>
                                <Image Source="zoom.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Se_ttings">
                        <MenuItem Header="_Classifier Defaults..." Name="menuClassifierDefaults" Click="menuClassifierDefaults_Click"
                                  ToolTip="Choose which classifiers are shown or hidden by default when logs are loaded."/>
                        <Separator/>
                        <MenuItem Header="Time-_gap cue">
                            <MenuItem Header="Show gap _border between rows" IsCheckable="True"
                                      IsChecked="{Binding Source={x:Static local:GapVisualSettings.Instance}, Path=ShowGapBorder, Mode=TwoWay}"
                                      ToolTip="Color the line between grid rows by the time gap to the previous row in the current view."/>
                            <MenuItem Header="Show _Δ (gap) column" IsCheckable="True"
                                      IsChecked="{Binding Source={x:Static local:GapVisualSettings.Instance}, Path=ShowGapColumn, Mode=TwoWay}"
                                      ToolTip="Show a column with the elapsed time since the previous row."/>
                            <Separator/>
                            <MenuItem StaysOpenOnClick="True">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Vertical" Width="240" Margin="4">
                                        <TextBlock Text="Show a line only for gaps at / above (seconds):" Margin="0,0,0,2"/>
                                        <DockPanel LastChildFill="True">
                                            <TextBox DockPanel.Dock="Right" Width="64" Margin="6,0,0,0"
                                                     Text="{Binding Source={x:Static local:GapVisualSettings.Instance}, Path=FloorSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>
                                            <Slider Minimum="0" Maximum="3600" SmallChange="1" LargeChange="30"
                                                    IsSnapToTickEnabled="False" VerticalAlignment="Center"
                                                    Value="{Binding Source={x:Static local:GapVisualSettings.Instance}, Path=FloorSeconds, Mode=TwoWay}"/>
                                        </DockPanel>
                                        <TextBlock Text="Highlight (full red) at / above (seconds):" Margin="0,8,0,2"/>
                                        <DockPanel LastChildFill="True">
                                            <TextBox DockPanel.Dock="Right" Width="64" Margin="6,0,0,0"
                                                     Text="{Binding Source={x:Static local:GapVisualSettings.Instance}, Path=HighlightThresholdSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>
                                            <Slider Minimum="1" Maximum="3600" SmallChange="1" LargeChange="60"
                                                    IsSnapToTickEnabled="False" VerticalAlignment="Center"
                                                    Value="{Binding Source={x:Static local:GapVisualSettings.Instance}, Path=HighlightThresholdSeconds, Mode=TwoWay}"/>
                                        </DockPanel>
                                        <TextBlock Text="Below the floor no line shows; between floor and highlight the line warms teal → red." 
                                                   Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Open Configuration _Folder" Name="menuOpenConfigFolder" Click="menuOpenConfigFolder_Click"
                                  ToolTip="Open the folder containing the configuration files (classifier scripts, LogPatterns.config, ClassifierVisibility.config, saved searches)."/>
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="_User Guide" Name="menuUserGuide" Click="menuUserGuide_Click"
                                  ToolTip="Open the HTML user guide (features, search fields, configuration, and extensibility) in your browser."/>
                        <Separator/>
                        <MenuItem Header="_About" Name="menuAbout" Click="menuAbout_Click"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="90" MinHeight="40"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical">
            <Grid Margin="5,4,5,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnHistoryBack" Click="btnHistoryBack_Click" Grid.Column="0"
                        Style="{StaticResource IconButton}" IsEnabled="False" Margin="0,0,2,0"
                        ToolTip="Back (Alt+Left) - return to the previous view">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button x:Name="btnHistoryForward" Click="btnHistoryForward_Click" Grid.Column="1"
                        Style="{StaticResource IconButton}" IsEnabled="False" Margin="0,0,6,0"
                        ToolTip="Forward (Alt+Right)">
                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button x:Name="btnRunSearch" Click="btnRunSearch_Click" Grid.Column="2"
                        Style="{StaticResource IconButton}" ToolTip="Run search">
                    <Image Source="magnifier.png" Width="16" Height="16"/>
                </Button>
                <Label Content="Query" Grid.Column="3" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}" Margin="6,0,4,0"/>
                <TextBox x:Name="txtSearchQuery" FontFamily="{StaticResource Font.Mono}" KeyUp="txtSearchQuery_KeyUp" Grid.Column="4"/>
                <Button x:Name="btnClearSearch" Click="btnClearSearch_Click" Grid.Column="5" Margin="5,0,0,0"
                        Style="{StaticResource IconButton}" ToolTip="Clear search">
                    <Image Source="cancel.png" Width="16" Height="16"/>
                </Button>

            </Grid>

            <!-- Find within results: marks (does NOT filter) rows in the current set whose full Content
                 matches. Distinct from the Query bar above. -->
            <Grid Margin="5,0,5,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Label Content="Find" Grid.Column="0" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,4,0"
                       ToolTip="Mark rows in the current results whose full content matches (does not filter the set)."/>
                <TextBox x:Name="txtFind" Grid.Column="1" FontFamily="{StaticResource Font.Mono}"
                         KeyUp="txtFind_KeyUp"
                         ToolTip="Type text to mark matching rows. Enter = next match, Shift+Enter = previous, Esc = clear."/>
                <CheckBox x:Name="chkFindRegex" Grid.Column="2" Content="Regex" VerticalAlignment="Center"
                          Margin="8,0,0,0" Click="findOptions_Changed"
                          ToolTip="Treat the term as a .NET regular expression (off = literal text)."/>
                <CheckBox x:Name="chkFindCase" Grid.Column="3" Content="Case" VerticalAlignment="Center"
                          Margin="8,0,0,0" Click="findOptions_Changed"
                          ToolTip="Case-sensitive matching."/>
                <TextBlock x:Name="lblFindStatus" Grid.Column="4" VerticalAlignment="Center"
                           Margin="10,0,4,0" MinWidth="70" Foreground="{StaticResource Brush.TextMuted}"/>
                <Button x:Name="btnFindPrev" Grid.Column="5" Click="btnFindPrev_Click" IsEnabled="False"
                        Style="{StaticResource IconButton}" ToolTip="Previous match (Shift+Enter)">
                    <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </Button>
                <Button x:Name="btnFindNext" Grid.Column="6" Click="btnFindNext_Click" IsEnabled="False"
                        Style="{StaticResource IconButton}" Margin="2,0,0,0" ToolTip="Next match (Enter)">
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </Button>
                <Button x:Name="btnFindClear" Grid.Column="7" Click="btnFindClear_Click" Margin="6,0,0,0"
                        Style="{StaticResource IconButton}" ToolTip="Clear find">
                    <Image Source="cancel.png" Width="14" Height="14"/>
                </Button>
            </Grid>
            </StackPanel>
            <local:LogEntryGrid x:Name="resultsGrid" Grid.Row="1" Grid.Column="0" SelectedLogEntryChanged="resultsGrid_SelectedLogEntryChanged" PivotAroundEntryRequested="resultsGrid_PivotAroundEntryRequested" VisibleRangeChanged="resultsGrid_VisibleRangeChanged" Margin="2"/>
            <!-- Drag to resize the timeline strip taller/shorter (useful when many job lanes are shown). -->
            <GridSplitter Grid.Row="2" Grid.Column="0" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            <local:LevelTimeChart x:Name="levelChart" Grid.Row="3" Grid.Column="0" Margin="2,0,2,0"/>
            <StatusBar Grid.Row="4" Grid.Column="0">
                <Label Content="Records:" FontWeight="Bold"/>
                <Label Name="lblRecordCounts" Content="0 / 0"/>
                <Separator/>
                <Button Name="lblInfoCount" Content="0" Click="lblInfoCount_Click"
                        Style="{StaticResource StatusChip}"
                        Background="{StaticResource Brush.Info.Fill}"
                        BorderBrush="{StaticResource Brush.Info}"
                        Foreground="{StaticResource Brush.Info}">
                    <Button.ToolTip>INFO entries — click to filter to only INFO.</Button.ToolTip>
                </Button>
                <Button Name="lblWarnCount" Content="0" Click="lblWarnCount_Click"
                        Style="{StaticResource StatusChip}" Margin="4,0,0,0"
                        Background="{StaticResource Brush.Warn.Fill}"
                        BorderBrush="{StaticResource Brush.Warn}"
                        Foreground="{StaticResource Brush.Warn}">
                    <Button.ToolTip>WARN entries — click to filter to only WARN.</Button.ToolTip>
                </Button>
                <Button Name="lblErrorCount" Content="0" Click="lblErrorCount_Click"
                        Style="{StaticResource StatusChip}" Margin="4,0,0,0"
                        Background="{StaticResource Brush.Error.Fill}"
                        BorderBrush="{StaticResource Brush.Error}"
                        Foreground="{StaticResource Brush.Error}">
                    <Button.ToolTip>ERROR entries — click to filter to only ERROR.</Button.ToolTip>
                </Button>
                <Button Name="lblDebugCount" Content="0" Click="lblDebugCount_Click"
                        Style="{StaticResource StatusChip}" Margin="4,0,0,0"
                        Background="{StaticResource Brush.Debug.Fill}"
                        BorderBrush="{StaticResource Brush.Debug}"
                        Foreground="{StaticResource Brush.Debug}">
                    <Button.ToolTip>DEBUG entries — click to filter to only DEBUG.</Button.ToolTip>
                </Button>
                <Separator/>
                <Label Content="Range:" FontWeight="Bold"/>
                <Label Name="lblDateRange" Content="—" FontFamily="{StaticResource Font.Mono}"
                       Cursor="Hand" MouseLeftButtonUp="lblDateRange_MouseLeftButtonUp">
                    <Label.ToolTip>Time span of the currently loaded log set (oldest to newest event). Click to copy the range and span to the clipboard.</Label.ToolTip>
                </Label>
                <Separator x:Name="sepExcluded" Visibility="Collapsed"/>
                <Label Name="lblExcluded" Visibility="Collapsed" Foreground="{StaticResource Brush.TextMuted}">
                    <Label.ToolTip>Rows removed from the current view by the active view-filters: hidden classifiers, hidden files, and hidden patterns (the eye toggles on the Classifiers, Files, and Patterns tabs).</Label.ToolTip>
                </Label>
            </StatusBar>
        </Grid>
        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch"/>
        <TabControl x:Name="bottomTabs" Grid.Row="3" Margin="2">
            <TabItem Header="Details" x:Name="tabDetails">
                <local:LogEntryViewer x:Name="logEntryViewer"/>
            </TabItem>
            <TabItem Header="Classifiers">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="4,3,4,3" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Show all" Name="btnShowAllFlags" Click="btnShowAllFlags_Click"
                                    Margin="6,0,0,0" Padding="8,2" MinHeight="0"
                                    ToolTip="Show every classifier's entries in the current view."/>
                            <Button Content="Hide all" Name="btnHideAllFlags" Click="btnHideAllFlags_Click"
                                    Margin="6,0,0,0" Padding="8,2" MinHeight="0"
                                    ToolTip="Hide every listed classifier's entries from the current view."/>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}"
                                   Text="Toggle the eye to hide a classifier's entries from the current view. Double-click a row to drill down. Defaults: Settings &gt; Classifier Defaults."/>
                    </DockPanel>
                    <ListView x:Name="flagList" Grid.Row="1" MouseDoubleClick="flagList_MouseDoubleClick"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding EyeGlyph}" ToolTip="{Binding EyeToolTip}"
                                                    Click="flagEyeToggle_Click" Tag="{Binding}"
                                                    Style="{StaticResource EyeToggleButton}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Classifier" DisplayMemberBinding="{Binding Name}" Width="200"/>
                                <GridViewColumn Header="Count" DisplayMemberBinding="{Binding Count, StringFormat='{}{0:N0}'}" Width="80"/>
                                <GridViewColumn Header="Description" Width="320">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}"
                                                       TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="Files">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="4,3,4,3" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Show all" Name="btnShowAllFiles" Click="btnShowAllFiles_Click"
                                    Margin="6,0,0,0" Padding="8,2" MinHeight="0"
                                    ToolTip="Show every source file's entries in the current view."/>
                            <Button Content="Hide all" Name="btnHideAllFiles" Click="btnHideAllFiles_Click"
                                    Margin="6,0,0,0" Padding="8,2" MinHeight="0"
                                    ToolTip="Hide every listed source file's entries from the current view."/>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}"
                                   Text="Source files found in the load, with entry counts for the current view. Toggle the eye to hide a file; double-click a row to drill down. Hover a name for its full path."/>
                    </DockPanel>
                    <ListView x:Name="fileList" Grid.Row="1" MouseDoubleClick="fileList_MouseDoubleClick"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding EyeGlyph}" ToolTip="{Binding EyeToolTip}"
                                                    Click="fileEyeToggle_Click" Tag="{Binding}"
                                                    Style="{StaticResource EyeToggleButton}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="File" Width="360">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Path}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Count" DisplayMemberBinding="{Binding Count, StringFormat='{}{0:N0}'}" Width="80"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="Patterns" x:Name="tabPatterns">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="2">
                        <Button x:Name="btnComputePatterns" DockPanel.Dock="Left" Content="Compute Patterns"
                                Click="btnComputePatterns_Click" Padding="6,2"
                                ToolTip="Group the current results by normalized message template."/>
                        <Button x:Name="btnHideAllPatterns" DockPanel.Dock="Left" Content="Hide all"
                                Click="btnHideAllPatterns_Click" Padding="6,2" Margin="10,0,0,0"
                                ToolTip="Hide every listed pattern's entries from the current view."/>
                        <Button x:Name="btnShowAllPatterns" DockPanel.Dock="Left" Content="Show all"
                                Click="btnShowAllPatterns_Click" Padding="6,2" Margin="6,0,0,0"
                                ToolTip="Un-hide every pattern (clears per-pattern hides)."/>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="14,0,4,0"
                                   Foreground="{StaticResource Brush.TextMuted}" Text="Expand by:"/>
                        <ComboBox x:Name="cmbPatternGroupBy" DockPanel.Dock="Left" VerticalAlignment="Center"
                                  Width="130" SelectionChanged="cmbPatternGroupBy_SelectionChanged"
                                  ToolTip="How to break a pattern into sub-patterns when expanded.">
                            <ComboBoxItem Content="Worker" IsSelected="True"/>
                            <ComboBoxItem Content="Exception"/>
                            <ComboBoxItem Content="Sub-template"/>
                        </ComboBox>
                        <TextBlock x:Name="lblPatternsStale" DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Margin="12,0,0,0" Visibility="Collapsed"
                                   Foreground="{StaticResource Brush.Warn}"
                                   Text="Visibility changed - listed counts are from the last Compute. Recompute to refresh."/>
                        <TextBlock x:Name="lblPatternsTotal" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Margin="0,0,4,0" Foreground="{StaticResource Brush.TextMuted}"
                                   ToolTip="Number of distinct patterns listed (and the total entries they cover)."/>
                    </DockPanel>
                    <DataGrid x:Name="patternList" Grid.Row="1" MouseDoubleClick="patternList_MouseDoubleClick"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                              SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="None"
                              RowDetailsVisibilityMode="Collapsed"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.CommandBindings>
                            <CommandBinding Command="Copy" Executed="patternCopyRows_Executed" CanExecute="patternCopy_CanExecute"/>
                        </DataGrid.CommandBindings>
                        <DataGrid.InputBindings>
                            <!-- Ctrl+C copies the full selected rows (tab-separated). -->
                            <KeyBinding Key="C" Modifiers="Control" Command="Copy"/>
                        </DataGrid.InputBindings>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy" Click="patternCopyRows_Click"
                                          ToolTip="Copy the selected rows (Count, First/Last Seen, Pattern) as tab-separated text."/>
                                <MenuItem Header="Copy Pattern(s) Only" Click="patternCopyTemplates_Click"
                                          ToolTip="Copy just the pattern template text of the selected rows, one per line."/>
                                <Separator/>
                                <MenuItem Header="Copy Summary (rich + Markdown)" Click="patternCopySummaryRich_Click"
                                          ToolTip="Copy a per-pattern summary (pattern, count, one real example) as HTML (rich paste) plus Markdown text."/>
                                <MenuItem Header="Copy Summary (for Slack)" Click="patternCopySummarySlack_Click"
                                          ToolTip="Copy a per-pattern summary using Slack mrkdwn (bold headers, fenced code blocks) - paste into a Slack message and send."/>
                                <MenuItem Header="Copy Summary (plain text)" Click="patternCopySummaryPlain_Click"
                                          ToolTip="Copy a per-pattern summary as plain text (no Markdown syntax)."/>
                                <Separator/>
                                <MenuItem Header="Save Summary to HTML File..." Click="patternSaveSummaryHtml_Click"
                                          ToolTip="Save a per-pattern summary (pattern, count, one real example) as a standalone HTML file."/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding Template}"/>
                                <Style.Triggers>
                                    <!-- Hidden patterns (eye-off) are greyed to show they're excluded
                                         from the current view; their listed counts remain as-computed. -->
                                    <DataTrigger Binding="{Binding IsShown}" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Expander: only shown when the folded pattern has >1 sub-pattern. Toggles
                                 this row's details (the nested sub-pattern list). -->
                            <DataGridTemplateColumn Header="" Width="26" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton Click="patternExpand_Click" Tag="{Binding}"
                                                      Focusable="False" BorderThickness="0" Background="Transparent"
                                                      ToolTip="Break this pattern into sub-patterns (by the 'Expand by' choice)">
                                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="34" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding EyeGlyph}" ToolTip="{Binding EyeToolTip}"
                                                Click="patternEyeToggle_Click" Tag="{Binding}"
                                                Style="{StaticResource EyeToggleButton}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Count" Binding="{Binding Count, StringFormat='{}{0:N0}'}" Width="70" SortMemberPath="Count"/>
                            <DataGridTemplateColumn Header="Level" Width="60" SortMemberPath="DominantLevel">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DominantLevel}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DominantLevel}" Value="ERROR">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Error}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DominantLevel}" Value="WARN">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Warn}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DominantLevel}" Value="INFO">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Info}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DominantLevel}" Value="DEBUG">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Debug}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ERR" Binding="{Binding Error, StringFormat='{}{0:N0}'}" Width="55" SortMemberPath="Error"/>
                            <DataGridTextColumn Header="WARN" Binding="{Binding Warn, StringFormat='{}{0:N0}'}" Width="55" SortMemberPath="Warn"/>
                            <DataGridTextColumn Header="INFO" Binding="{Binding Info, StringFormat='{}{0:N0}'}" Width="55" SortMemberPath="Info"/>
                            <DataGridTextColumn Header="DBG" Binding="{Binding Debug, StringFormat='{}{0:N0}'}" Width="55" SortMemberPath="Debug"/>
                            <DataGridTextColumn Header="First Seen" Binding="{Binding FirstSeen, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="140" SortMemberPath="FirstSeen"/>
                            <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="140" SortMemberPath="LastSeen"/>
                            <DataGridTextColumn Header="Pattern" Binding="{Binding Template}" Width="900" SortMemberPath="Template"/>
                        </DataGrid.Columns>
                        <!-- Row details: the more-specific sub-patterns folded into this pattern. Its own
                             read-only grid, drill-down on double-click. Shown only when expanded. -->
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <!-- Sub-patterns view. Uses an ItemsControl with a shared-size Grid per
                                     row (not a nested DataGrid, which collapses to minimum size inside a
                                     RowDetails/ScrollViewer). Columns align via SharedSizeGroup; each row
                                     handles double-click to drill down. Sizes to content. -->
                                <Border Margin="60,2,8,6" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                        Background="{StaticResource Brush.SurfaceAlt}" HorizontalAlignment="Stretch"
                                        Grid.IsSharedSizeScope="True">
                                    <StackPanel Margin="2">
                                        <!-- Header row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cGroup"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cCount"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cErr"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cWarn"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cInfo"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cDbg"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Group" FontWeight="SemiBold" Margin="6,2" MinWidth="180"/>
                                            <TextBlock Grid.Column="1" Text="Count" FontWeight="SemiBold" Margin="10,2" MinWidth="50" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="ERR" FontWeight="SemiBold" Margin="10,2" MinWidth="40" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="WARN" FontWeight="SemiBold" Margin="10,2" MinWidth="40" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="INFO" FontWeight="SemiBold" Margin="10,2" MinWidth="40" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="5" Text="DBG" FontWeight="SemiBold" Margin="10,2" MinWidth="40" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="6" Text="Detail" FontWeight="SemiBold" Margin="10,2"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding MemberPatterns}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Double-click a sub-pattern row to drill down. -->
                                                    <Border Background="Transparent" MouseLeftButtonDown="patternMemberRow_Click"
                                                            ToolTip="Double-click to drill the grid to this sub-group's entries">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cGroup"/>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cCount"/>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cErr"/>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cWarn"/>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cInfo"/>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="cDbg"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Margin="6,1" MinWidth="180" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat='{}{0:N0}'}" Margin="10,1" MinWidth="50" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Error, StringFormat='{}{0:N0}'}" Margin="10,1" MinWidth="40" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Warn, StringFormat='{}{0:N0}'}" Margin="10,1" MinWidth="40" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding Info, StringFormat='{}{0:N0}'}" Margin="10,1" MinWidth="40" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding Debug, StringFormat='{}{0:N0}'}" Margin="10,1" MinWidth="40" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="6" Text="{Binding Template}" Margin="10,1" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Jobs" x:Name="tabJobs">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="2">
                        <Button x:Name="btnComputeJobs" DockPanel.Dock="Left" Content="Compute Jobs"
                                Click="btnComputeJobs_Click"
                                ToolTip="Group the current results into worker jobs and show each job's lifespan."/>
                        <CheckBox x:Name="chkShowJobsOnChart" DockPanel.Dock="Left" Content="Show on timeline"
                                  IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0"
                                  Click="chkShowJobsOnChart_Click"
                                  ToolTip="Overlay the computed job lifespans as brackets above the timeline chart."/>
                    </DockPanel>
                    <ListView x:Name="jobList" Grid.Row="1" MouseDoubleClick="jobList_MouseDoubleClick"
                              GridViewColumnHeader.Click="jobList_ColumnHeaderClick"
                              SelectionChanged="jobList_SelectionChanged"
                              SelectionMode="Extended"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="ToolTip" Value="{Binding JobId}"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource SortableHeaderStyle}">
                                <GridViewColumn Header="Job" DisplayMemberBinding="{Binding JobId}" Width="290"/>
                                <GridViewColumn Header="Start" DisplayMemberBinding="{Binding FirstSeen, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="140"/>
                                <GridViewColumn Header="End" DisplayMemberBinding="{Binding LastSeen, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="140"/>
                                <GridViewColumn Header="Duration" DisplayMemberBinding="{Binding DurationText}" Width="90"/>
                                <GridViewColumn Header="Entries" DisplayMemberBinding="{Binding EntryCount, StringFormat='{}{0:N0}'}" Width="70"/>
                                <GridViewColumn Header="Warns" DisplayMemberBinding="{Binding WarnCount, StringFormat='{}{0:N0}'}" Width="60"/>
                                <GridViewColumn Header="Errors" DisplayMemberBinding="{Binding ErrorCount, StringFormat='{}{0:N0}'}" Width="60"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="Insights" x:Name="tabInsights">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="2">
                        <Button x:Name="btnAnalyzeInsights" DockPanel.Dock="Left" Content="Analyze" Padding="6,2"
                                Click="btnAnalyzeInsights_Click"
                                ToolTip="Scan the whole loaded corpus for notable things worth looking into. Double-click a finding to jump to it."/>
                        <TextBlock x:Name="lblInsightsInfo" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Margin="0,0,4,0" Foreground="{StaticResource Brush.TextMuted}"/>
                    </DockPanel>
                    <ListView x:Name="insightList" Grid.Row="1" MouseDoubleClick="insightList_MouseDoubleClick"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="ToolTip" Value="{Binding Query}"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.TextMuted}" Margin="2,6,0,2"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource SortableHeaderStyle}">
                                <GridViewColumn Header="Severity" DisplayMemberBinding="{Binding Severity}" Width="80"/>
                                <GridViewColumn Header="Finding" DisplayMemberBinding="{Binding Title}" Width="300"/>
                                <GridViewColumn Header="Detail" DisplayMemberBinding="{Binding Detail}" Width="640"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Name="busyOverlay" Visibility="Collapsed" Grid.Row="0" Grid.RowSpan="4">
            <Border.Background>
                <SolidColorBrush Color="#000000" Opacity="0.30"/>
            </Border.Background>
            <Border Background="{StaticResource Brush.Surface}" Margin="40,0,40,0" MaxWidth="560" Height="200"
                    VerticalAlignment="Center" CornerRadius="{StaticResource Radius.Control}"
                    BorderThickness="1" BorderBrush="{StaticResource Brush.Border}">
                <Border.Effect>
                    <DropShadowEffect Color="#40000000" ShadowDepth="4" BlurRadius="18"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource Brush.Brand}" CornerRadius="4,4,0,0">
                        <Label Content="Please Wait…" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Brush.TextOnBrand}" Padding="14,8,14,8"/>
                    </Border>
                    <TextBlock Name="lblStatus" Grid.Row="1" FontSize="13" Margin="14,10,14,4" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Text}"/>
                    <Grid Grid.Row="2" Margin="14,0,14,4">
                        <TextBlock Name="lblProgress" FontSize="13" VerticalAlignment="Top"
                                   Foreground="{StaticResource Brush.TextMuted}"/>
                        <Button Name="btnCancelBusy" Content="Cancel" Click="btnCancelBusy_Click"
                                Visibility="Collapsed" Padding="14,4" MinWidth="90"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                ToolTip="Stop the current operation and return to the previous view."/>
                    </Grid>
                    <ProgressBar Grid.Row="3" IsIndeterminate="True" Height="4" Margin="0"
                                 Background="{StaticResource Brush.SurfaceAlt}" BorderThickness="0"
                                 Foreground="{StaticResource Brush.Brand}"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
