<Window x:Class="NuixLogReviewer.GUI.ClassifierDefaultsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NuixLogReviewer.GUI"
        mc:Ignorable="d"
        Title="Classifier Defaults" Width="420" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.WindowBackground}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="2,2,2,8" Foreground="{StaticResource Brush.TextMuted}"
                   Text="Check a classifier to SHOW its entries by default when logs are loaded; uncheck to HIDE them by default. These are defaults only - you can still toggle visibility per session in the Classifiers tab. Takes effect on the next load."/>

        <Border Grid.Row="1" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="flagItems" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding Shown, Mode=TwoWay}" Margin="2,3,2,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Label x:Name="lblFeedback" Foreground="{StaticResource Brush.Error}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="Cancel" Name="btnCancel" Click="btnCancel_Click" Margin="4,0,0,0" MinWidth="72"/>
            <Button Content="Save" Name="btnSave" Click="btnSave_Click" Margin="6,0,0,0" MinWidth="72"/>
        </StackPanel>
    </Grid>
</Window>
