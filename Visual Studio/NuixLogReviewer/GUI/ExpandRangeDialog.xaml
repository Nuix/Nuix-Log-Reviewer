<Window x:Class="NuixLogReviewer.GUI.ExpandRangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NuixLogReviewer.GUI"
        mc:Ignorable="d"
        Title="Expand Time Range" Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Current range" Grid.Row="0" Grid.Column="0" HorizontalContentAlignment="Right"/>
        <TextBox x:Name="txtCurrent" Grid.Row="0" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas"
                 VerticalContentAlignment="Center" Margin="3" Background="#FFF0F0F0"/>

        <Label Content="Add to each end (±)" Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Right"/>
        <TextBox x:Name="txtAmount" Grid.Row="1" Grid.Column="1" FontFamily="Consolas"
                 VerticalContentAlignment="Center" Margin="3"/>

        <!-- Quick presets: fixed durations set the amount directly; the multipliers (x2/x5/x10) set the
             amount so the TOTAL span grows by that factor. -->
        <WrapPanel Grid.Row="2" Grid.Column="1" Margin="3,0,3,0">
            <Button Content="+1m"  Tag="dur:1m"  Click="preset_Click" Padding="6,1" Margin="0,0,4,0"/>
            <Button Content="+5m"  Tag="dur:5m"  Click="preset_Click" Padding="6,1" Margin="0,0,4,0"/>
            <Button Content="+15m" Tag="dur:15m" Click="preset_Click" Padding="6,1" Margin="0,0,4,0"/>
            <Button Content="+1h"  Tag="dur:1h"  Click="preset_Click" Padding="6,1" Margin="0,0,4,0"/>
            <Button Content="+1d"  Tag="dur:1d"  Click="preset_Click" Padding="6,1" Margin="0,0,12,0"/>
            <Button Content="×2"   Tag="mul:2"   Click="preset_Click" Padding="6,1" Margin="0,0,4,0"/>
            <Button Content="×5"   Tag="mul:5"   Click="preset_Click" Padding="6,1" Margin="0,0,4,0"/>
            <Button Content="×10"  Tag="mul:10"  Click="preset_Click" Padding="6,1" Margin="0,0,0,0"/>
        </WrapPanel>

        <TextBlock Grid.Row="3" Grid.Column="1" Foreground="Gray" TextWrapping="Wrap" Margin="3,4,3,0"
                   Text="Examples: 1h, 30m, 2d, 90s (a bare number means seconds). This amount is subtracted from the start and added to the end, widening the current time range symmetrically. The ×N presets grow the total span by that factor."/>

        <Label Content="New range" Grid.Row="4" Grid.Column="0" HorizontalContentAlignment="Right"/>
        <TextBox x:Name="txtPreview" Grid.Row="4" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas"
                 VerticalContentAlignment="Center" Margin="3" Background="#FFF0F0F0" Foreground="#FF1B5E20"/>

        <Label x:Name="lblFeedback" Foreground="DarkRed" Grid.Row="5" Grid.Column="1" Margin="3"/>

        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="3">
            <Button Content="Cancel" Name="btnCancel" Click="btnCancel_Click" Width="80" Margin="5,0,0,0"/>
            <Button Content="Expand" Name="btnExpand" Click="btnExpand_Click" Width="80" Margin="5,0,0,0" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
