<Window x:Class="NuixLogReviewer.GUI.PivotTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NuixLogReviewer.GUI"
        mc:Ignorable="d"
        Title="Pivot Around Event Time" Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Event time" Grid.Row="0" Grid.Column="0" HorizontalContentAlignment="Right"/>
        <TextBox x:Name="txtEventTime" Grid.Row="0" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas"
                 VerticalContentAlignment="Center" Margin="3" Background="#FFF0F0F0"/>

        <Label Content="Window (±)" Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Right"/>
        <TextBox x:Name="txtWindow" Grid.Row="1" Grid.Column="1" FontFamily="Consolas"
                 VerticalContentAlignment="Center" Margin="3"/>

        <TextBlock Grid.Row="2" Grid.Column="1" Foreground="Gray" TextWrapping="Wrap" Margin="3,0,3,0"
                   Text="Examples: 1h, 30m, 2d, 90s (a bare number means seconds). The search will be replaced with a time range spanning this window on each side of the event."/>

        <Label x:Name="lblFeedback" Foreground="DarkRed" Grid.Row="3" Grid.Column="1" Margin="3"/>

        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="3">
            <Button Content="Cancel" Name="btnCancel" Click="btnCancel_Click" Width="80" Margin="5,0,0,0"/>
            <Button Content="Pivot" Name="btnPivot" Click="btnPivot_Click" Width="80" Margin="5,0,0,0" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
