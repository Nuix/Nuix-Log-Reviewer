<UserControl x:Class="NuixLogReviewer.GUI.LogEntryGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NuixLogReviewer.GUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:GapToBrushMultiConverter x:Key="GapToBrush"/>
        <local:GapToTextConverter x:Key="GapToText"/>
        <!-- Find-within-results indicator dot. Deliberately magenta so it never reads as a log LEVEL
             (red/amber/green/cyan) or as the blue selection/brand accent. -->
        <SolidColorBrush x:Key="Brush.FindMatch" Color="#D500F9"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <DataGrid  Name="resultsGrid" Grid.Row="0" SelectedCellsChanged="resultsGrid_SelectedCellsChanged"
                  LoadingRow="resultsGrid_LoadingRow"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserResizeRows="False" CanUserSortColumns="False" SelectionMode="Single">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource Color.BrandTint}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource Color.BrandTint}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1B1D21"/>
            </DataGrid.Resources>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Pivot Around Event Time..." Name="menuPivotAroundEvent" Click="menuPivotAroundEvent_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <!-- <DataGridTextColumn Header="ID" Binding="{Binding ID}" FontFamily="Consolas"/> -->
                <!-- Find-within-results indicator: a magenta dot on rows matching the active Find term.
                     Column is collapsed unless a Find is active (toggled from code-behind, like colGap).
                     The dot itself is bound to each row's MatchHighlight. -->
                <DataGridTemplateColumn x:Name="colFindMatch" Header="" Width="18" Visibility="Collapsed"
                                        CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="9" Height="9" Fill="{StaticResource Brush.FindMatch}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding MatchHighlight, Converter={StaticResource BoolToVis}}"
                                     ToolTip="Matches the current Find term"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- File shows the shortest-unique path tail (matching the Files tab); the full path is
                     the tooltip. -->
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" FontFamily="Consolas">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" FontFamily="Consolas"/>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeStamp, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" FontFamily="Consolas"/>
                <!-- Δ (gap to previous row in the current view). Visibility toggled from code-behind. -->
                <DataGridTextColumn x:Name="colGap" Header="Δ" Binding="{Binding GapToPrevious, Converter={StaticResource GapToText}}"
                                    FontFamily="Consolas" Visibility="Collapsed"/>
                <!--<DataGridTextColumn Header="Channel" Binding="{Binding Channel}" FontFamily="Consolas"/>-->
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" FontFamily="Consolas"/>
                <!--<DataGridTextColumn Header="Source" Binding="{Binding Source}" FontFamily="Consolas"/>-->
                <DataGridTextColumn Header="Content" Binding="{Binding ContentBrief}" Width="*" FontFamily="Consolas"/>
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <!-- Time-gap cue: color the row's TOP border by the gap to the previous row, so the
                         line sits BETWEEN the two rows it separates (the gap value lives on the later
                         row). A MultiBinding to the live threshold/floor makes it repaint when the scale
                         changes; the converter returns transparent below the floor or when toggled off. -->
                    <Setter Property="BorderThickness" Value="0,2,0,0"/>
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource GapToBrush}">
                                <Binding Path="GapToPrevious"/>
                                <Binding Path="HighlightThresholdSeconds"
                                         Source="{x:Static local:GapVisualSettings.Instance}"/>
                                <Binding Path="ShowGapBorder"
                                         Source="{x:Static local:GapVisualSettings.Instance}"/>
                                <Binding Path="FloorSeconds"
                                         Source="{x:Static local:GapVisualSettings.Instance}"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="ERROR">
                            <Setter Property="Background" Value="#3FFF0000"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="WARN">
                            <Setter Property="Background" Value="#3FFFFF00"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="INFO">
                            <Setter Property="Background" Value="#3F00FF13"></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="DEBUG">
                            <Setter Property="Background" Value="#3F00F2FF"></Setter>
                        </DataTrigger>
                        <!-- Selection MUST win over the Level-color DataTriggers above. Within
                             Style.Triggers the last matching trigger takes precedence, so this
                             IsSelected trigger (placed last) overrides the per-level Background that
                             would otherwise hide the selection highlight. Strong brand fill + light
                             text so the selected row is unmistakable regardless of its level. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Brand}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>
