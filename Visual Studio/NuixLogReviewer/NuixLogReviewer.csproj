<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>logReviewer.ico</ApplicationIcon>

    <!-- Assembly metadata (migrated from Properties\AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Nuix Log Reviewer</AssemblyTitle>
    <Product>Nuix Log Reviewer</Product>
    <Company>Nuix</Company>
    <Description>Assists in reviewing Nuix log files - Apache 2.0 Licensed</Description>
    <Copyright>Copyright © 2020</Copyright>
    <Version>3.1.0.0</Version>
    <AssemblyVersion>3.1.0.0</AssemblyVersion>
    <FileVersion>3.1.0.0</FileVersion>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="LogRepository\InsertLogEntry.sqlite" />
    <EmbeddedResource Include="LogRepository\LogEntrySelectIdList.sqlite" />
    <EmbeddedResource Include="LogRepository\LogEntrySelect.sqlite" />
    <EmbeddedResource Include="LogRepository\InitializeDatabase.sqlite" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="magnifier.png" />
    <Resource Include="cancel.png" />
    <Resource Include="logReviewer.ico" />
    <Resource Include="folder_page.png" />
    <Resource Include="page_save.png" />
    <Resource Include="folder.png" />
    <Resource Include="page_white_text.png" />
    <Resource Include="report_disk.png" />
    <Resource Include="zoom_in.png" />
    <Resource Include="zoom.png" />
    <Resource Include="Assets\nuix-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="DependencyLicenses\OokiiDialogs.Wpf-LICENSE.TXT">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DependencyLicenses\ICON-LICENSE.TXT">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DependencyLicenses\J2N-LICENSE.TXT">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DependencyLicenses\Lucene.net-LICENSE.TXT">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DependencyLicenses\SharpCompress-LICENSE.TXT">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DependencyLicenses\SQLite-LICENSE.TXT">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="LICENSE.TXT">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\SavedSearches\*.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\LogPatterns.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\ClassifierVisibility.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\ClassifierScripts\*.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\InsightScripts\*.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Help\UserGuide.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Assets\uplot\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00018" />
    <PackageReference Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00018" />
    <PackageReference Include="Lucene.Net.QueryParser" Version="4.8.0-beta00018" />
    <PackageReference Include="Jint" Version="4.16.2" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>
</Project>
